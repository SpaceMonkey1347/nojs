{
  "name": "no-js",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"pnpm run sass:watch\" \"pnpm run sync\"",
    "sass:watch": "sass src/styles:src/dist/css --no-source-map --error-css --watch",
    "sass:build": "sass src/styles:src/dist/css --no-source-map --error-css",
    "sync": "browser-sync start --server 'src' --files 'src/**/*' --reload-delay 500 --no-notify",
    "format": "prettier --write src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.3",
    "prettier": "^3.9.6",
    "sass": "^1.101.6"
  }
}
