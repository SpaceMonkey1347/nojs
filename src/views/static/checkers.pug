-
    const TOP = [1, 2, 3, 4]
    const RIGHT = [4, 12, 20, 28]
    const BOTTOM = [29, 30, 31, 32]
    const LEFT = [5, 13, 21, 29]

    function edgeCases(square, className) {
        let classes = [];
        if (TOP.includes(square)) {
            classes.push(`top-${className}`)
        }
        if (RIGHT.includes(square)) {
            classes.push(`right-${className}`)
        }
        if (BOTTOM.includes(square)) {
            classes.push(`bottom-${className}`)
        }
        if (LEFT.includes(square)) {
            classes.push(`left-${className}`)
        }
        if (classes.length === 0) {
            classes.push(`middle-${className}`)
        }
        return classes.join(' ')
    }

mixin piece(player, checked)
    if player == 'light'
        - checked = 32 - checked
    else
        - checked++
    form(class=`${player}-piece piece` autocomplete="off")
        - let row = 8
        - let count = 0
        .positions
            while count < 32
                - count++
                if count == checked
                    input.pos(class=`${edgeCases(count, 'pos')}` type="radio", name="pos" checked)
                else
                    input.pos(class=`${edgeCases(count, 'pos')}` type="radio", name="pos")
        .piece-state
            label.dead-label
                input.dead(type="checkbox")
            label.king-label
                input.king(type="checkbox")

doctype html
html
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title Checkers
        link(href="/dist/css/main.css" rel="stylesheet")
        link(href="/dist/css/checkers.css" rel="stylesheet")
    body
        include ../partials/_navbar.pug
        .game-container
            .board-display
                - let strips = 8
                while strips--
                    .strip
            .board
                each player in ['dark', 'light']
                    - let piece = 12
                    while piece--
                        +piece(player, piece)
                form.sources(autocomplete="off")
                    - let count = 0
                    while count < 32
                        - count++
                        input.source(class=`${edgeCases(count, 'source')}` type="radio" name="source")
                    input.deselect(type="radio" name="source" checked)
                - count = 0
                while count < 32
                    - count++
                    .blocker(class=`${edgeCases(count, 'blocker')}`)
